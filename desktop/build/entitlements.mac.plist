<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Dictation records from the microphone (ADR-0025). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- The daemon reaches the model providers and the connections. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The daemon binds the loopback port the window loads. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Chromium needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
