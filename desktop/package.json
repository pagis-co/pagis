{
  "name": "pagis-desktop",
  "productName": "Pagis",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "The Pagis Client App installs and owns one exact local Server Runtime.",
  "main": "dist/clientMain.js",
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-design.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "pack:linux": "npm run build && electron-builder --linux --x64 --arm64 --config electron-builder.yml"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.8.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "homepage": "https://github.com/pagis-co/pagis",
  "desktopName": "pagis-client.desktop"
}
