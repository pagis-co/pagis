{
  "name": "pagis-ui",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:generate": "cargo run -q -p pagis-server --bin openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "api:check": "npm run -s api:generate && git diff --exit-code -- openapi.json src/api/schema.d.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fast-png": "^8.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-router": "^1.170.32",
    "lucide-react": "^1.41.0",
    "openapi-fetch": "^0.17.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "type": "module"
}
