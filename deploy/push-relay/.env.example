# The settings of one Push Relay. Copy to `.env`, fill in, and
# `docker compose up -d`. Every one of these is stated here once:
# nothing in `compose.yaml` is edited for a deployment.
# `docs/PUSH-RELAY.md` holds each setting of the relay.

# The Compose files of the deployment. `compose.yaml` serves the iOS app
# through APNs. To serve the Android app through FCM too, add
# `compose.fcm.yaml`: COMPOSE_FILE=compose.yaml:compose.fcm.yaml
COMPOSE_FILE=compose.yaml

# The version of the relay image, `ghcr.io/pagis-co/pagis-push-relay`.
# Each `push-relay-v<version>` tag publishes one.
PUSH_RELAY_VERSION=0.1.0

# The name that the Mobile App and each server reach the relay at: the
# published application route of the Cloudflare Tunnel. Cloudflare holds
# its certificate. The relay gives each Mobile App the endpoints
# `https://<this name>/v1/push/<id>`. The token of the tunnel is not a
# setting: it is the file `secrets/cloudflared-token`.
PUSH_RELAY_DOMAIN=push.example.net

# The 10-character ID of the APNs key of the production environment: the
# TestFlight and App Store builds of the Mobile App. The `.p8` file of the
# key is `secrets/apns-production-key.p8`.
PUSH_RELAY_APNS_PRODUCTION_KEY_ID=ABC123DEFG

# The 10-character ID of the APNs key of the sandbox environment: the
# debug builds of the Mobile App. The `.p8` file of the key is
# `secrets/apns-sandbox-key.p8`.
PUSH_RELAY_APNS_SANDBOX_KEY_ID=GHI456JKLM

# The 10-character ID of the Apple developer team that holds the keys.
PUSH_RELAY_APNS_TEAM_ID=DEF123GHIJ

# The bundle ID of the Mobile App, which APNs reads as the topic of each
# push.
PUSH_RELAY_APNS_TOPIC=co.pagis.mobile

# The ID of the Firebase project of the Mobile App. Only
# `compose.fcm.yaml` reads it. The JSON key of the service account that
# sends is `secrets/fcm-credentials.json`.
PUSH_RELAY_FCM_PROJECT_ID=pagis-mobile
