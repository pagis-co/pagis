# The settings of one Pagis server. Copy to `.env`, fill in, and
# `docker compose up -d`. Every one of these is stated here once:
# nothing in `compose.yaml` is edited for a deployment.

# The release. The server image, the server package and the client of
# one release carry the same number; `docs/RELEASING-SERVER.md` holds
# the rule and what a mismatch does.
PAGIS_VERSION=0.1.0

# The name a browser reaches this server at. Caddy obtains the
# certificate for it, so it resolves to this machine before the first
# start.
PAGIS_DOMAIN=pagis.example.net

# The public address of this machine. A browser reaches the Media Relay
# at it, so it is the address of the machine and not of a container.
PAGIS_PUBLIC_IP=198.51.100.7

# The Media Relay's UDP range. One port serves one viewer session, so
# twenty ports are twenty people watching a screen at once. Open exactly
# this range in the VM's firewall, and nothing else.
PAGIS_MEDIA_PORT_FIRST=50000
PAGIS_MEDIA_PORT_LAST=50019

# The private destinations that an Agent's Computer reaches: IPv4
# addresses and CIDR blocks, separated by commas, such as
# 10.0.5.0/24,192.168.1.40. A Computer reaches the internet and the
# Media Relay, and no link-local or private address outside this list.
# Empty by default. The list opens no address of this machine.
PAGIS_COMPUTER_ALLOW=

# The database password. Postgres holds the records of every person on
# this server.
PAGIS_DATABASE_PASSWORD=change-me

# The first run, without a browser. They are read at the first
# start that finds nobody who can sign in, and ignored from then on.
# Leave them empty to finish setup on the administration port instead:
#   ssh -L 4401:127.0.0.1:4401 <this machine>
#   open http://127.0.0.1:4401/
PAGIS_ADMIN_EMAIL=
PAGIS_ADMIN_PASSWORD=

# The installation's model keys. The administrator configures them once
# for everybody; no person and no client ever takes a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
