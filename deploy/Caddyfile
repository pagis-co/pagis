# The TLS end of a Pagis server (ADR-0024).
#
# Caddy obtains and renews the certificate, forwards the WebSocket
# upgrades, and writes the two headers the daemon reads from it: the
# browser's scheme in `X-Forwarded-Proto` and the browser's address in
# `X-Forwarded-For`. `docs/DEPLOYING-A-SERVER.md` holds an nginx
# configuration beside it.
#
# The admin API of Caddy is off. Nothing in the deployment uses it, and
# it would listen on the loopback of the VM. The daemon has the VM's
# network, and every HTTP Plugin server can make the daemon send a
# request to that loopback. A request to the admin API can stop the
# proxy. Caddy reads this file only when it starts, so a change takes
# effect after `docker compose restart proxy`.
{
	admin off
}

{$PAGIS_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4400
}
